rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isStaff() {
      return true;
    }

    // Connection test endpoint
    match /test/{testId} {
      allow read, write: if true;
    }

    // Products collection
    match /products/{productId} {
      allow read, write: if isStaff();
    }

    // Stock collection
    match /stock/{stockId} {
      allow read, write: if isStaff();
    }

    // Sales collection
    match /sales/{saleId} {
      allow read, write: if isStaff();
    }

    // Cash shifts (abertura e fechamento de caixa)
    match /cash_shifts/{shiftId} {
      allow read, write: if isStaff();
    }
  }
}

