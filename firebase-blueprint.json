{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Ice cream, popsicle, beverage or dessert item sold at Eliza Sorvetes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "enum": ["sorvete", "picole", "bebida", "sobremesa"] },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "requiresFlavors": { "type": "boolean" },
        "flavorType": { "type": "string", "maxLength": 50 },
        "maxFlavors": { "type": "number" },
        "badge": { "type": "string", "maxLength": 50 },
        "iconName": { "type": "string", "maxLength": 50 },
        "colorBg": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "category", "price", "description", "requiresFlavors"]
    },
    "StockItem": {
      "title": "StockItem",
      "description": "Inventory stock tracking for flavors, scoops, and retail items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "enum": ["Sorvete", "Picolé", "Bebida", "Sobremesa"] },
        "quantity": { "type": "number" },
        "minQuantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "category", "quantity", "minQuantity", "unit", "updatedAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed point-of-sale transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["dinheiro", "pix", "cartao_debito", "cartao_credito"] },
        "amountReceived": { "type": "number" },
        "change": { "type": "number" },
        "cashierName": { "type": "string", "maxLength": 100 },
        "customerName": { "type": "string", "maxLength": 100 },
        "shiftId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "timestamp", "items", "subtotal", "discount", "total", "paymentMethod"]
    },
    "CashShift": {
      "title": "CashShift",
      "description": "Cash register shift tracking opening balance, sales, movements, and reconciliations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["aberto", "fechado"] },
        "openedAt": { "type": "string", "maxLength": 100 },
        "closedAt": { "type": "string", "maxLength": 100 },
        "operatorName": { "type": "string", "maxLength": 120 },
        "initialCash": { "type": "number" },
        "movements": { "type": "array" },
        "totalCashSales": { "type": "number" },
        "totalPixSales": { "type": "number" },
        "totalDebitSales": { "type": "number" },
        "totalCreditSales": { "type": "number" },
        "totalSalesAmount": { "type": "number" },
        "totalSalesCount": { "type": "number" },
        "expectedCash": { "type": "number" },
        "countedCash": { "type": "number" },
        "difference": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "hasAdjustment": { "type": "boolean" },
        "adjustmentAmount": { "type": "number" },
        "adjustmentReason": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "status", "openedAt", "operatorName", "initialCash", "expectedCash"]
    },
    "SalesReport": {
      "title": "SalesReport",
      "description": "Consolidated sales report and financial metrics automatically stored for daily or monthly summaries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["diario", "mensal", "fechamento_caixa"] },
        "periodDate": { "type": "string", "maxLength": 100 },
        "periodLabel": { "type": "string", "maxLength": 120 },
        "totalRevenue": { "type": "number" },
        "totalSalesCount": { "type": "number" },
        "totalItemsSold": { "type": "number" },
        "averageTicket": { "type": "number" },
        "paymentBreakdown": { "type": "object" },
        "topFlavors": { "type": "array" },
        "salesIds": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 },
        "generatedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "type", "periodDate", "totalRevenue", "totalSalesCount", "totalItemsSold", "averageTicket", "createdAt", "updatedAt"]
    },
    "TubPurchase": {
      "title": "TubPurchase",
      "description": "Ice cream tub and popsicle purchase log and batch entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["compra_setembro", "estoque_anterior", "compra_regular"] },
        "tubsCount": { "type": "number" },
        "volumePerTubLiters": { "type": "number" },
        "estimatedScoopsPerTub": { "type": "number" },
        "popsiclesCount": { "type": "number" },
        "flavor": { "type": "string", "maxLength": 120 },
        "supplier": { "type": "string", "maxLength": 120 },
        "cost": { "type": "number" },
        "lotNumber": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "date", "timestamp", "type", "tubsCount", "volumePerTubLiters", "estimatedScoopsPerTub", "createdBy", "createdAt"]
    },
    "StockConference": {
      "title": "StockConference",
      "description": "Physical stock count, theoretical balance, and scoop audit reconciliation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "auditorName": { "type": "string", "maxLength": 120 },
        "estimatedScoopsPerTub": { "type": "number" },
        "tubsInitial": { "type": "number" },
        "tubsPurchased": { "type": "number" },
        "tubsSoldEquivalent": { "type": "number" },
        "tubsTheoretical": { "type": "number" },
        "tubsPhysicalCounted": { "type": "number" },
        "tubsDifference": { "type": "number" },
        "scoopsSold": { "type": "number" },
        "scoopsEstimatedFromTubs": { "type": "number" },
        "scoopsDifference": { "type": "number" },
        "physicalTubsList": { "type": "array" },
        "status": { "type": "string", "enum": ["conforme", "alerta_diferenca", "divergencia_a_conferir"] },
        "investigationNotes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "date", "timestamp", "auditorName", "estimatedScoopsPerTub", "tubsTheoretical", "tubsPhysicalCounted", "tubsDifference", "status"]
    },
    "DailyClosureRecord": {
      "title": "DailyClosureRecord",
      "description": "Immutable daily closure snapshot containing sales, revenue, scoops, stock and purchases",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 100 },
        "closedAt": { "type": "string", "maxLength": 100 },
        "closedBy": { "type": "string", "maxLength": 120 },
        "version": { "type": "number" },
        "totalSalesCount": { "type": "number" },
        "totalRevenue": { "type": "number" },
        "paymentBreakdown": { "type": "object" },
        "productsSold": { "type": "object" },
        "bolasConsumidas": { "type": "number" },
        "baldesEquivalentes": { "type": "number" },
        "cascoes1BolaCount": { "type": "number" },
        "cascoes2BolasCount": { "type": "number" },
        "sundaesCount": { "type": "number" },
        "picolesCount": { "type": "number" },
        "comprasBaldes": { "type": "number" },
        "comprasPicoles": { "type": "number" },
        "estoqueInformado": { "type": "number" },
        "estoqueTeorico": { "type": "number" },
        "diferenca": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "date", "closedAt", "closedBy", "version", "totalSalesCount", "totalRevenue", "bolasConsumidas"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of products available for sale in Eliza Sorvetes"
    },
    "/stock/{stockId}": {
      "schema": "StockItem",
      "description": "Current inventory stock levels and replenishment alert thresholds"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Completed POS checkout receipts and sales history"
    },
    "/cash_shifts/{shiftId}": {
      "schema": "CashShift",
      "description": "Cash register shifts, opening balance, and drawer audit history"
    },
    "/sales_reports/{reportId}": {
      "schema": "SalesReport",
      "description": "Consolidated sales reports generated and stored automatically in Firestore"
    },
    "/tub_purchases/{purchaseId}": {
      "schema": "TubPurchase",
      "description": "Log of ice cream tub and popsicle purchases"
    },
    "/stock_conferences/{conferenceId}": {
      "schema": "StockConference",
      "description": "Audit records comparing physical stock of tubs against sales consumption"
    },
    "/daily_closures/{closureId}": {
      "schema": "DailyClosureRecord",
      "description": "Immutable daily closure records with complete sales and stock snapshots"
    }
  }
}
